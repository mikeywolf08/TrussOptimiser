curves = pd.read_csv(io.StringIO(CURVE_CSV))
CURVES = {m: (g.sort_values("lb")["lb"].values, g.sort_values("lb")["sigma"].values)
          for m, g in curves.groupby("mode")}

def read_members():
    src = None if USE_CLIPBOARD else io.StringIO(RAW)
    kw = dict(sep=r"[\s,]+", engine="python", header=None)
    df = pd.read_clipboard(**kw) if USE_CLIPBOARD else pd.read_csv(src, **kw)
    df = df.iloc[:, :3].apply(pd.to_numeric, errors="coerce").dropna() # i cant be bothered to remove headings when i copypaste sometimes
    df.columns = ["No", "Length_mm", "Load_N"]
    df["No"] = df["No"].astype(int)
    return df.reset_index(drop=True)


# ------------------------------ CALCULATIONS --------------------------
def eff_area(b, t, dt=HOLE_DT):
    hole = dt * t if HOLE_AS_AREA else dt
    return 0.9 * (2 * b * t - hole - b * t / 2)


def sigma_cr(mode, lb):
    x, y = CURVES[mode]
    return 0.0 if lb > x[-1] else float(np.interp(lb, x, y)) # it refuses to stop throwing errors if i dont put if-else


def candidates(length, load):
    out = []
    for bar in BARS.itertuples():
        size = f"{bar.b:g}x{bar.t:g}"
        if load > 0:                                 
            out.append((size, "single", SIGMA_Y * eff_area(bar.b, bar.t), bar.mpl * length))
        elif load == 0:
            out.append((size, "half", 0, bar.mpl * length/2))
        else:                                           
            lb = length / bar.b                         
            out.append((size, "single", sigma_cr("A", lb) * bar.area, bar.mpl * length))
            s_dbl = min(sigma_cr("B", lb), sigma_cr("C", lb))   
            out.append((size, "double", s_dbl * 2 * bar.area, 2 * bar.mpl * length))
    return out


def design(members):
    rows = []
    for m in members.itertuples():
        ok = [c for c in candidates(m.Length_mm, m.Load_N) if c[2] >= SAFETY * abs(m.Load_N)]
        if ok:
            size, cfg, cap, mass = min(ok, key=lambda c: c[3])
            util = round(100 * abs(m.Load_N) / cap, 1) if cap > 0 else 0.0  
            rows.append([m.No, m.Length_mm, m.Load_N, size, cfg, round(cap), util, round(mass, 1)])
        else:
            rows.append([m.No, m.Length_mm, m.Load_N, size, cfg, round(cap), util, round(mass, 1)])
    return pd.DataFrame(rows, columns=["No", "Length (mm)", "Load (N)", "Size", "Config",
                                       "Capacity (N)", "Util (%)", "Mass (g)"])


